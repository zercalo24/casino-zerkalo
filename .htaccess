# ══════════════════════════════════════════════════════════════
#  casino-zerkalo.online — .htaccess
#  Обновлено: 2026-05-21
# ══════════════════════════════════════════════════════════════

Options -Indexes

# ── РЕДИРЕКТЫ ────────────────────────────────────────────────
# КРИТИЧНО: HTML-файлы попали в папку /images/ — дублируют страницы.
# 301 → сигнал поисковикам, что канонический URL — в корне сайта.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Редиректы дублей из /images/
  RewriteRule ^images/1win-zerkalo\.html$              /1win-zerkalo.html              [R=301,L]
  RewriteRule ^images/arkada-casino-zerkalo\.html$     /arkada-casino-zerkalo.html     [R=301,L]
  RewriteRule ^images/auf-casino-zerkalo\.html$        /auf-casino-zerkalo.html        [R=301,L]
  RewriteRule ^images/banda-casino-zerkalo\.html$      /banda-casino-zerkalo.html      [R=301,L]
  RewriteRule ^images/beef-casino-zerkalo\.html$       /beef-casino-zerkalo.html       [R=301,L]
  RewriteRule ^images/cactus-casino-zerkalo\.html$     /cactus-casino-zerkalo.html     [R=301,L]
  RewriteRule ^images/casino-x-zerkalo\.html$          /casino-x-zerkalo.html          [R=301,L]
  RewriteRule ^images/cat-casino-zerkalo\.html$        /cat-casino-zerkalo.html        [R=301,L]
  RewriteRule ^images/champion-slots-zerkalo\.html$    /champion-slots-zerkalo.html    [R=301,L]
  RewriteRule ^images/cryptoboss-zerkalo\.html$        /cryptoboss-zerkalo.html        [R=301,L]

  # Редиректы дублей в корне → правильные папки
  # bonusy-kazino-2026.html живёт в /bonusy/ — корневая копия → 301
  RewriteRule ^bonusy-kazino-2026\.html$               /bonusy/bonusy-kazino-2026.html [R=301,L]
  # zerkala-kazino-2026.html живёт в /blog/ — корневая копия → 301
  RewriteRule ^zerkala-kazino-2026\.html$              /blog/zerkala-kazino-2026.html  [R=301,L]
  # kazino-bez-verifikacii-2026.html canonical указывает на /blog/ — редирект
  RewriteRule ^kazino-bez-verifikacii-2026\.html$      /blog/kazino-bez-verifikacii-2026.html [R=301,L]
  # kazino-bystryj-vyvod-2026.html canonical указывает на /blog/ — редирект
  RewriteRule ^kazino-bystryj-vyvod-2026\.html$        /blog/kazino-bystryj-vyvod-2026.html   [R=301,L]
</IfModule>

# ── КЭШИРОВАНИЕ ──────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Изображения — 1 год
  ExpiresByType image/png          "access plus 1 year"
  ExpiresByType image/webp         "access plus 1 year"
  ExpiresByType image/jpeg         "access plus 1 year"
  ExpiresByType image/gif          "access plus 1 year"
  ExpiresByType image/svg+xml      "access plus 1 year"
  ExpiresByType image/x-icon       "access plus 1 year"

  # CSS и JS — 1 месяц
  ExpiresByType text/css           "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript    "access plus 1 month"

  # Шрифты — 1 год
  ExpiresByType font/woff2         "access plus 1 year"
  ExpiresByType font/woff          "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # HTML — без кэша (всегда свежий)
  ExpiresByType text/html          "access plus 0 seconds"
</IfModule>

# ── ЗАГОЛОВКИ CACHE-CONTROL ───────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(png|webp|jpg|jpeg|gif|svg|ico|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── GZIP СЖАТИЕ ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml
</IfModule>

# ── КАСТОМНЫЕ СТРАНИЦЫ ОШИБОК ────────────────────────────────
ErrorDocument 404 /index.html
